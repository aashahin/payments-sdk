{
  "name": "@abshahin/payments-sdk",
  "version": "0.8.0",
  "description": "Unified, framework-agnostic payment SDK for Bun & TypeScript. Seamlessly integrate Moyasar, PayPal, Paymob, Stripe and other payment gateways with type-safe lifecycle hooks and normalized webhooks.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare/index.d.ts",
      "source": "./src/cloudflare/index.ts",
      "import": "./dist/cloudflare/index.js",
      "default": "./dist/cloudflare/index.js"
    },
    "./bun": {
      "types": "./dist/bun/index.d.ts",
      "source": "./src/bun/index.ts",
      "import": "./dist/bun/index.js",
      "default": "./dist/bun/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run build:node && bun run build:bun && bun run build:cloudflare && bun run build:types",
    "build:node": "bun build ./src/index.ts --outdir ./dist --target node --format esm --packages external",
    "build:bun": "bun build ./src/bun/index.ts --outdir ./dist/bun --target bun --format esm --packages external",
    "build:cloudflare": "bun build ./src/cloudflare/index.ts --outdir ./dist/cloudflare --target browser --format esm --packages external",
    "build:types": "tsc --emitDeclarationOnly --declaration --outDir dist",
    "dev": "bun --watch src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "engines": {
    "node": ">=18",
    "bun": ">=1.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.0.3",
    "typescript": "7.0.2"
  },
  "peerDependencies": {},
  "keywords": [
    "payment",
    "gateway",
    "moyasar",
    "paypal",
    "paymob",
    "stripe",
    "multi-gateway",
    "typescript"
  ],
  "author": "Abdelrahman Shaheen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aashahin/payments-sdk.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/aashahin/payments-sdk#readme",
  "dependencies": {
    "zod": "3.25.76"
  }
}
